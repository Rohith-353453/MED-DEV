APP_ENV=local
API_PREFIX=/api
DATABASE_URL=sqlite+aiosqlite:///./healthcopilot.db
AUTO_CREATE_SCHEMA=true
AUTH_MODE=mock
MOCK_USER_SUB=local-demo-user
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=medical-documents
QUEUE_PROVIDER=local
AZURE_STORAGE_QUEUE_ACCOUNT_URL=
AZURE_STORAGE_QUEUE_NAME=document-processing
QUEUE_MESSAGE_VISIBILITY_SECONDS=3600
PROCESSING_LEASE_SECONDS=3300
OCR_PROVIDER=mock
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Optional per-task overrides; if blank, both tasks use AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=
AZURE_OPENAI_SUMMARY_DEPLOYMENT=
AZURE_OPENAI_EXTRACTION_MAX_TOKENS=4096
AZURE_OPENAI_SUMMARY_MAX_TOKENS=1500
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
ENTRA_TENANT_ID=
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_JWKS_URI=
ENTRA_API_AUDIENCE=api://<api-client-id>
ENTRA_REQUIRED_SCOPE=access_as_user
FIREBASE_PROJECT_ID=
FRONTEND_ORIGINS=http://localhost:5173
APPLICATIONINSIGHTS_CONNECTION_STRING=
MAX_DOCUMENT_PAGES=2
AZURE_DOCUMENT_INTELLIGENCE_MAX_MB=4
