VITE_API_BASE_URL=/api
# Leave these blank for local AUTH_MODE=mock development.
# For Entra External ID, configure an SPA app registration with Authorization Code + PKCE.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/v2.0
VITE_ENTRA_API_SCOPE=api://<api-app-client-id>/access_as_user
# Optional until the External ID sign-up/sign-in user flow is created and associated with the SPA.
VITE_ENTRA_USER_FLOW=SignUpSignIn
# Must exactly match a redirect URI registered for the SPA. Defaults to window.location.origin.
VITE_ENTRA_REDIRECT_URI=
